# AI Nexus Backend Environment Variables
# Copy this to .env and fill in your values

# App Settings
APP_NAME=AI Nexus
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-base64-64

# Server
HOST=0.0.0.0
PORT=8000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://ainexus.ai

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ainexus
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/ainexus

# Redis (for caching and queues)
REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# AI Service Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
HUGGING_FACE_API_KEY=your-hf-api-key

# Vector Database
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@ainexus.ai

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_FREE=price_free_plan_id
STRIPE_PRICE_PRO=price_pro_plan_id
STRIPE_PRICE_BUSINESS=price_business_plan_id

# Cloudflare (for security)
CLOUDFLARE_API_KEY=your-cloudflare-api-key
CLOUDFLARE_ZONE_ID=your-zone-id

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json