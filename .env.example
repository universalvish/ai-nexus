# Secure Environment Variables Template
# Copy this file to .env in each respective directory and fill in the values

===========================================
BACKEND (.env)
===========================================

# Application
APP_NAME=AI Nexus
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Security - CRITICAL: Generate strong random values
SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE_64_CHARS_MIN
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Database (Supabase PostgreSQL)
# Get these from Supabase Dashboard > Settings > Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (Supabase Edge Functions or external)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# AI Services - Store these as GitHub Secrets!
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
HUGGINGFACE_API_KEY=hf-your-huggingface-key

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_BUSINESS=price_your_business_price_id

# Supabase Auth
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# CORS (Frontend URLs only)
CORS_ORIGINS=https://your-frontend.vercel.app,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com
EMERGENCY_STOP_ENABLED=true

===========================================
FRONTEND (.env.local)
===========================================

# Next.js
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=AI Nexus
NEXT_PUBLIC_APP_URL=https://www.yourdomain.com

# API URLs - Backend on Render
NEXT_PUBLIC_API_URL=https://ai-nexus-api.onrender.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://ai-nexus-api.onrender.com

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
NEXT_PUBLIC_STRIPE_PRICE_ID_PRO=price_your_pro_price_id

# Authentication
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_64_CHARS
NEXTAUTH_URL=https://www.yourdomain.com

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

===========================================
DOCKER (.env)
===========================================

# PostgreSQL (if running locally)
POSTGRES_USER=ainnexus
POSTGRES_PASSWORD=YOUR_SECURE_DB_PASSWORD
POSTGRES_DB=ainnexus

# Redis
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# JWT Secrets
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_ALGORITHM=HS256

# Cloudflare (for production)
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ZONE_ID=your_zone_id

===========================================
RENDER (render.yaml)
===========================================

# These will be set in Render Dashboard > Environment

# Service: ai-nexus-api
# Plan: Free (auto-sleeps after 15 min, use Starter for 24/7)
# Build Command: pip install -r requirements.txt
# Start Command: gunicorn app.main:app --bind 0.0.0.0:$PORT --workers 2

# Environment Variables (set in dashboard):
# - DATABASE_URL: postgresql://...
# - REDIS_URL: redis://...
# - SECRET_KEY: <generate strong random>
# - DEBUG: false
# - ENVIRONMENT: production
# - CORS_ORIGINS: https://your-frontend.vercel.app

===========================================
VERCEL (vercel.json)
===========================================

# Configure in Vercel Dashboard:
# - Framework: Next.js
# - Environment Variables: All NEXT_PUBLIC_ vars
# - Security: Enable Password Protection (optional)
# - Regions: Auto (closest to users)